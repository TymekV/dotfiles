{
  "$schema": "https://vicinae.com/schemas/config.json",
  "close_on_focus_loss": false,
  "pop_to_root_on_close": true,
  "font": {
    "rendering": "qt",
    "normal": {
      // Doesn't work for now, see https://github.com/vicinaehq/vicinae/issues/1022
      "family": "Google Sans Medium",
      "size": 10.5
    }
  },
  "theme": {
    "dark": {
      "name": "catppuccin-mocha",
      "icon_theme": "Adwaita"
    }
  },
  "launcher_window": {
    "opacity": 0.85,
    "client_side_decorations": {
      "enabled": true
    },
    "layer_shell": {
      // Allows the windo to be on top of everything in Niri
      "layer": "overlay"
    }
  },
  "providers": {
    "@bastiangx/store.vicinae.crates-io": {
      "entrypoints": {
        "search-crates": {
          "alias": "c"
        }
      }
    },
    "@bl4zee1g/store.vicinae.bitwarden": {
      "preferences": {
        "rbwPath": "rbw"
      },
      "entrypoints": {
        "browse-vault": {
          "alias": "b"
        }
      }
    },
    "@fbosch/store.vicinae.nerdfont-search": {
      "entrypoints": {
        "nerdfonts-search": {
          "alias": "n:"
        }
      }
    },
    "@fbosch/store.vicinae.protondb-search": {
      "entrypoints": {
        "protondb-search": {
          "alias": "pro"
        }
      }
    },
    "@knoopx/store.vicinae.github": {
      "preferences": {
        "defaultIssueFilter": "my",
        "defaultRepositoryFilter": "my",
        "numberOfResults": "50"
      },
      "entrypoints": {
        "createIssue": {
          "enabled": false
        },
        "createPullRequest": {
          "enabled": false
        },
        "issues": {
          "enabled": false
        },
        "pullRequests": {
          "enabled": false
        },
        "searchRepositories": {
          "alias": "gh r"
        },
        "workflowRuns": {
          "enabled": false
        }
      }
    },
    "@mitsimi/store.raycast.gitea": {
      "preferences": {
        "serverUrl": "https://git.agin.rocks",
        "cloneProtocol": "ssh",
        "dateFormat": "YYYY-MM-DD",
        "editorCursor": true,
        "editorIntelliJ": true,
        "editorVSCode": true,
        "editorZed": true
      },
      "entrypoints": {
        "repository-explore": {
          "alias": "ga r"
        }
      }
    },
    "@pavle99/store.vicinae.zed-recents": {
      "entrypoints": {
        "open-recents": {
          "alias": "z"
        }
      }
    },
    "@thomaslombart/store.raycast.github": {
      "preferences": {
        "defaultSearchTerms": "author:@me",
        "includeTeamReviewRequests": true,
        "isOpenInBrowser": false,
        "repositoryCloneProtocol": "ssh",
        "repositoryFilterMode": "all",
        "vscodeBuild": "vscode"
      },
      "entrypoints": {
        "my-pull-requests": {
          "alias": "gh pr"
        },
        "search-repositories": {
          "alias": "gh r",
          "enabled": false,
          "preferences": {
            "application": "/Applications/Visual Studio Code.app",
            "disableThrottle": false,
            "displayOwnerName": false,
            "includeArchived": false,
            "includeForks": true
          }
        }
      }
    },
    "calculator": {
      "preferences": {
        "backend": "soulver-core"
      }
    },
    "clipboard": {
      "preferences": {
        "monitoring": true
      }
    },
    "snippets": {
      "preferences": {
        "enabled": true,
        "keyDelay": "2",
        "layout": "",
        "prePasteDelay": "0",
        "undo": true
      }
    },
    "@Costeer/store.vicinae.color-converter": {
      "entrypoints": {
        "convert-color": {
          "alias": "cc"
        }
      }
    },
    "clipboard": {
      "preferences": {
        "encryption": true,
        "eraseOnStartup": false,
        "ignorePasswords": true,
        "monitoring": true
      },
      "entrypoints": {
        "history": {
          "enabled": true,
          "preferences": {
            "defaultAction": "copy"
          }
        }
      }
    },
    "core": {
      "entrypoints": {
        "search-emojis": {
          "alias": ":"
        }
      }
    },
    "files": {
      "entrypoints": {
        "search": {
          "alias": "f"
        }
      }
    }
  }
}
